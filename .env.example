# ── Damage-Check Module — environment configuration ──────────────────────────
# Copy this file to .env and fill in values before running docker compose.
# Every variable is optional — the defaults shown here are the baseline config.

# ── Stage selection ───────────────────────────────────────────────────────────
DAMAGE_SEGMENTER=rembg          # rembg | sam  (sam → Phase 3)
DAMAGE_ALIGNER=sift             # sift  | loftr (loftr → Phase 3)
DAMAGE_COMPARATOR=ssim          # ssim  | dino  (dino  → Phase 3)
DAMAGE_ENABLE_VLM=false         # true → Phase 4

# ── Storage ───────────────────────────────────────────────────────────────────
DAMAGE_STORAGE_BACKEND=local    # local | s3
DAMAGE_OUTPUT_DIR=output        # only used when STORAGE_BACKEND=local

# ── Thresholds ────────────────────────────────────────────────────────────────
DAMAGE_BLUR_THRESHOLD=100.0           # Laplacian variance minimum
DAMAGE_BRIGHTNESS_MIN=30.0
DAMAGE_BRIGHTNESS_MAX=220.0
DAMAGE_MIN_OBJECT_FRACTION=0.05       # foreground pixels / total
DAMAGE_ALIGNMENT_MIN_SCORE=0.3        # RANSAC inlier ratio threshold
DAMAGE_DAMAGE_SCORE_THRESHOLD=0.4     # heatmap value above which a pixel is "damage"
DAMAGE_MIN_REGION_PIXELS=200          # smallest contour area to report

# ── Device ────────────────────────────────────────────────────────────────────
DAMAGE_DEVICE=cpu               # cpu | cuda

# ── AWS / S3 (only needed when DAMAGE_STORAGE_BACKEND=s3) ────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
DAMAGE_S3_BUCKET=
DAMAGE_S3_PREFIX=damage-check/
